# Copy to canary.toml to customize run defaults.
repeats = 3
results_dir = "results"
deadline_s = 120
stall_s = 30
thinking_models = []
hermes_deadline_s = 300

# Managed Ollama settings.
# v0.1 CLI model set: --models llama3.2:3b,granite4:3b-h
asset_name = "ollama-darwin.tgz"
port = 11535
context_length = 65536
kv_cache_type = "q8_0"
min_free_gb = 5
allow_full_copy = false
# Unset by default. Optional read-only, clonefile-only seeding on macOS.
# seed_store = "~/.ollama/models"
