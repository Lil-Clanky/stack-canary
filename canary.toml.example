# Copy to canary.toml to customize run defaults.
repeats = 3
results_dir = "results"
deadline_s = 120
stall_s = 30
thinking_models = []
hermes_deadline_s = 300

# Managed Ollama settings.
# CLI model set: --models llama3.2:3b,granite4:3b-h,qwen3.5:0.8b
asset_name = "ollama-darwin.tgz"
port = 11535
context_length = 65536
kv_cache_type = "q8_0"
min_free_gb = 5
# Refuse to load a model above this swap use, and stop Ollama if a run exceeds it.
max_swap_gb = 4
allow_full_copy = false
# Unset by default. Optional read-only, clonefile-only seeding on macOS.
# seed_store = "~/.ollama/models"

# Release watcher and cleanup.
models = ["llama3.2:3b", "granite4:3b-h", "qwen3.5:0.8b"]
watch_versions = 2
hermes_tag = "v0.23.2"
keep_runtimes = 3
keep_hermes = 2
notify_on_success = false
# notify_command = ["/absolute/path/to/notify"]


# Optional local notifications and private matrix publishing.
# notify = ["macos", "ntfy"]
# ntfy_server = "https://ntfy.sh"
# ntfy_topic = "set-your-private-topic-in-canary.toml"
# publish_branch = "matrix"
# publish_gh_user = "Lil-Clanky"
